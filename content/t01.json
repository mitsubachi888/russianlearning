  {
   "id": "A",
   "title": "Bảng chữ cái: nhóm 1 và 2",
   "minutes": 25,
   "steps": [
    {
     "type": "video",
     "videoId": "fdzOjmirnQA",
     "start": 36,
     "end": 428,
     "title": "Andrei – Nhập môn Tập 01: bảng chữ cái",
     "note": "Xem đoạn 0:36–7:08: 33 chữ cái, 6 cặp phụ âm hữu thanh/vô thanh, bốn âm \"s\", hai nhóm nguyên âm. Chưa cần nhớ hết — các bước sau luyện từng nhóm."
    },
    {
     "type": "note",
     "title": "Cách học bảng chữ trong app",
     "md": "App chia 33 chữ thành 5 nhóm theo **mức độ dễ nhầm với người biết tiếng Đức, tiếng Anh**, không theo thứ tự А-Б-В.\n\n- Nhóm 1 (hôm nay): giống chữ Latinh, đọc giống\n- Nhóm 2 (hôm nay): **chữ bẫy** — giống chữ Latinh nhưng đọc khác\n- Nhóm 3–5: chủ đề 2\n\nChữ **đỏ** = nguyên âm mang trọng âm. Bấm vào từng chữ để xem từ ví dụ và nghe."
    },
    {
     "type": "letters",
     "title": "Nhóm 1: giống chữ Latinh, đọc giống",
     "letters": [
      {
       "ch": "А а",
       "snd": "[a]",
       "hint": "Như a tiếng Việt.",
       "words": [
        "w.mama",
        "w.tam"
       ]
      },
      {
       "ch": "К к",
       "snd": "[k]",
       "hint": "Như k/c tiếng Việt. Không bật hơi như k tiếng Đức, tiếng Anh.",
       "words": [
        "w.kot",
        "w.tak"
       ]
      },
      {
       "ch": "М м",
       "snd": "[m]",
       "hint": "Như m.",
       "words": [
        "w.mama"
       ]
      },
      {
       "ch": "О о",
       "snd": "[o]",
       "hint": "Đọc o khi mang trọng âm. Không trọng âm thì đọc gần a — học ở chủ đề 2.",
       "words": [
        "w.kot",
        "w.kto"
       ]
      },
      {
       "ch": "Т т",
       "snd": "[t]",
       "hint": "Như t tiếng Việt. Không bật hơi như t tiếng Đức, tiếng Anh.",
       "words": [
        "w.tam",
        "w.kto"
       ]
      }
     ]
    },
    {
     "type": "letters",
     "title": "Nhóm 2: chữ bẫy",
     "intro": "Trông giống chữ Latinh nhưng đọc khác. Đây là nhóm người biết tiếng Đức, tiếng Anh hay đọc sai nhất.",
     "letters": [
      {
       "ch": "В в",
       "snd": "[v]",
       "hint": "Không phải B. Đọc [v] như w trong Wasser.",
       "cmp": "v",
       "words": [
        "w.vot",
        "w.moskva"
       ]
      },
      {
       "ch": "Е е",
       "snd": "[je] / [ʲe]",
       "hint": "Đầu từ, sau nguyên âm, sau ь/ъ đọc je như tiếng Đức. Sau phụ âm: làm phụ âm mềm đi, không có [j].",
       "cmp": "ya",
       "words": [
        "w.net",
        "w.metro"
       ]
      },
      {
       "ch": "Н н",
       "snd": "[n]",
       "hint": "Không phải H. Đọc n.",
       "words": [
        "w.net",
        "w.on"
       ]
      },
      {
       "ch": "Р р",
       "snd": "[r]",
       "hint": "Không phải P. R rung đầu lưỡi — không dùng R lưỡi gà kiểu tiếng Đức.",
       "cmp": "r",
       "words": [
        "w.restoran",
        "w.ruka"
       ]
      },
      {
       "ch": "С с",
       "snd": "[s]",
       "hint": "Không phải C/K. Đọc s (thầy Andrei: như \"x\" tiếng Việt, xinh xắn).",
       "cmp": "z_s",
       "words": [
        "w.sok",
        "w.sestra"
       ]
      },
      {
       "ch": "У у",
       "snd": "[u]",
       "hint": "Không phải Y. Đọc u.",
       "words": [
